# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pharma_crm
# For sync operations (alembic)
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/pharma_crm

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# External APIs
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# Redis (for caching, rate limiting, offline sync queue)
REDIS_URL=redis://localhost:6379/0

# Application
APP_NAME=PharmaTrack API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# GPS Verification
DEFAULT_CHECKIN_RADIUS_METERS=200

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60